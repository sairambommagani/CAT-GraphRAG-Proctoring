# ---------------- NVIDIA NIM (AI judge) ----------------
# build.nvidia.com -> any model page -> "Get API Key"
NVIDIA_API_KEY=nvapi-xxxxxxxx

# Judge model chain, first available wins (automatic fallback if a model isn't enabled for your key):
#   1. Cosmos 3 Reasoner  - NVIDIA physical-AI video reasoning (gaze, hands, phone, people)
#   2. Nemotron 3 Omni    - hears the audio + sees the video (routed first for speech events)
#   3. Llama 3.2 Vision   - single-image fallback
NIM_MODELS=nvidia/cosmos3-nano-reasoner,nvidia/nemotron-3-nano-omni-30b-a3b-reasoning,meta/llama-3.2-11b-vision-instruct
NIM_REASONING=1               # let reasoning models think before the verdict (more accurate, a few seconds slower)
NIM_REASONING_TOKENS=768      # budget for reasoning + answer
NIM_SEND_AUDIO=1              # send the clip's audio to Nemotron Omni for speech events
# NIM_BASE_URL=https://integrate.api.nvidia.com/v1   # or a self-hosted NIM, e.g. http://nim-host:8000/v1
NIM_RPM=30
NIM_DAILY_CALLS=200
NIM_DAILY_TOKENS=600000

# ---------------- Microphone ----------------
PROCTOR_ASR=1                 # speech-to-text of flagged clips (faster-whisper, runs locally)
PROCTOR_ASR_MODEL=base        # tiny | base | small (bigger = more accurate, slower)
# PROCTOR_ASR_LANGUAGE=en     # force a language; default auto-detects (Hindi, Telugu, English...)

# ---------------- Exam knowledge graph (GraphRAG) ----------------
# NVIDIA NIM text models for question generation / verification / syllabus conversion (first available wins)
EXAM_LLM_MODELS=nvidia/llama-3.3-nemotron-super-49b-v1.5,meta/llama-3.3-70b-instruct
EXAM_DATA_DIR=data/exam       # question bank, response log (analytics)
PROCTOR_KNOWLEDGE_GRAPH=1     # proctoring rules + past incidents -> judge context and examiner Q&A
# PROCTOR_KG_LLM=meta/llama-3.1-8b-instruct   # optional: NIM text model phrases examiner answers

# ---------------- Retention / security ----------------
PROCTOR_EVIDENCE_KEY=         # python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PROCTOR_ADMIN_TOKEN=change-me
PROCTOR_DATA_DIR=data/proctoring
# PROCTOR_MOCK_JUDGE=1        # offline rule-based judge for UI testing, no API calls

# CAT: 0 = accept answers without an active proctoring session (dev only)
CAT_REQUIRE_PROCTORING=1

# Object/hand detection (phone, notes, extra person, foreign hand). 0 = face tracking only
PROCTOR_OBJECT_DETECTION=1

# ---- Semantic cache for examiner Q&A (Redis LangCache) ----
# Leave empty to use the local semantic cache (NVIDIA embeddings, in memory).
LANGCACHE_SERVER_URL=
LANGCACHE_CACHE_ID=
LANGCACHE_API_KEY=
SEMANTIC_CACHE_THRESHOLD=0.9
